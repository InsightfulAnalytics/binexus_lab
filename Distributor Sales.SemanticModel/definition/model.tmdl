model Model
	culture: en-AU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Shipped

	annotation PBI_QueryGroupOrder = 1

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DataFolder","OrderLines","Sales","Product","Customer","Supplier"]

ref table Sales
ref table Product
ref table Customer
ref table Supplier

